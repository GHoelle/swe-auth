# Template only. Never commit the real .env.
#
# Normally you do not edit this file by hand: scripts/bootstrap.sh (or bootstrap.ps1
# on Windows) copies it to .env and fills in freshly generated secrets.
#
# To generate one yourself:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (token_urlsafe only uses URL-safe characters, so it won't break the connection URLs,
# where a '/', '@' or ':' would silently change what the URL means.)

ENVIRONMENT=development

POSTGRES_USER=auth_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth

REDIS_PASSWORD=change-me

# Optional. Defaults: 30 minutes idle, 8 hours absolute (OWASP ranges).
# SESSION_IDLE_TIMEOUT_SECONDS=1800
# SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
