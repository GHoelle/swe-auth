# Copy this file to .env and fill in real values. Never commit .env.
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (token_urlsafe only uses URL-safe characters, so it won't break the connection URLs.)

ENVIRONMENT=development

POSTGRES_USER=auth_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth

REDIS_PASSWORD=change-me

# Optional. Defaults: 30 minutes idle, 8 hours absolute (OWASP ranges).
# SESSION_IDLE_TIMEOUT_SECONDS=1800
# SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
